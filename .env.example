# Copy to .env (gitignored) and fill in. These are read by ask_server.py.

# Your Google Gemini API key (aistudio.google.com/app/apikey). Uses the free
# tier — separate from and does not touch a Gemini subscription. Never commit
# the real value.
GEMINI_API_KEY=AIza-REPLACE-ME

# Model for the Ask box. Flash is fast + generous on the free tier and reads
# screenshots well; bump to gemini-2.5-pro for sharper answers.
ASK_MODEL=gemini-2.5-flash

# PIN lock. Set APP_PIN to require a password before anyone can view the page
# or use the Ask box. AUTH_SECRET signs the login cookie — set it to a long
# random string. Leave APP_PIN blank to disable the lock (local dev only).
APP_PIN=
AUTH_SECRET=

# Port ask_server.py listens on (Caddy reverse-proxies to it).
ASK_PORT=8787

# OPTIONAL — YouTube Data API v3 key for the daily digest's topic search
# (console.cloud.google.com → enable "YouTube Data API v3"). If blank, the
# digest still runs on curated-creator RSS + Reddit.
YOUTUBE_API_KEY=

