# Serves the dashboard + /api/ask endpoint. Copy to /etc/systemd/system/,
# edit User= and the path, then: systemctl enable --now swgoh-ask
#
# Secrets (API key, PIN, signing secret) live ONLY here (root-readable unit
# file), never in git. Set APP_PIN + AUTH_SECRET to lock the page and the
# paid Ask box; leave APP_PIN blank only for an unlocked local test.
[Unit]
Description=SWGOH dashboard + Gemini Ask endpoint
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/swgoh-dashboard
Environment=GEMINI_API_KEY=AIza-REPLACE-ME
Environment=ASK_MODEL=gemini-2.5-flash
Environment=APP_PIN=REPLACE-WITH-YOUR-PIN
Environment=AUTH_SECRET=REPLACE-WITH-A-LONG-RANDOM-STRING
Environment=ASK_PORT=8787
ExecStart=/usr/bin/python3 /home/ubuntu/swgoh-dashboard/ask_server.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
